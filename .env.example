# Copy to .env and fill in. .env is git-ignored: never commit keys, and never put real keys in this file.

# Required for the target (ground PM2.5). Free: https://explore.openaq.org -> account -> API key
OPENAQ_API_KEY=

# Required for fire features. Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional: publish the app snapshot to a Hugging Face dataset repo (write token)
HF_TOKEN=
HF_DATASET_REPO=your-hf-user/peshgo-snapshot

# Optional: an OpenAI-compatible model that only rewords answers (rejected if it adds a number)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
